{
    "Rules": [
        {
            "Name": "DO-NOT-DELETE-AmazonInspectorEc2ManagedRule",
            "Arn": "arn:aws:events:us-west-2:363979333641:rule/DO-NOT-DELETE-AmazonInspectorEc2ManagedRule",
            "EventPattern": "{\"source\": [\"aws.ec2\"], \"detail-type\": [\"EC2 Instance State-change Notification\"], \"detail\": {\"state\":[\"running\", \"stopped\", \"terminated\"]}}",
            "State": "ENABLED",
            "Description": "Managed rule used to route EC2 Events to Inspector",
            "ManagedBy": "inspector2.amazonaws.com",
            "EventBusName": "default"
        },
        {
            "Name": "DO-NOT-DELETE-AmazonInspectorEc2TagManagedRule",
            "Arn": "arn:aws:events:us-west-2:363979333641:rule/DO-NOT-DELETE-AmazonInspectorEc2TagManagedRule",
            "EventPattern": "{\"source\": [\"aws.tag\"], \"detail-type\": [\"Tag Change on Resource\"], \"detail\": {\"service\":[\"ec2\"], \"resource-type\":[\"instance\"]}}",
            "State": "ENABLED",
            "Description": "Managed rule used to route EC2 Tag Change Events to Inspector",
            "ManagedBy": "inspector2.amazonaws.com",
            "EventBusName": "default"
        },
        {
            "Name": "DO-NOT-DELETE-AmazonInspectorEcrManagedRule",
            "Arn": "arn:aws:events:us-west-2:363979333641:rule/DO-NOT-DELETE-AmazonInspectorEcrManagedRule",
            "EventPattern": "{\"source\": [\"aws.ecr\", \"aws.ecs\"], \"detail-type\": [\"ECR Image Action\", \"ECR Scan Resource Change\", \"ECS Task State Change\"]}",
            "State": "ENABLED",
            "Description": "Managed rule used to route ECR and ECS Events to Inspector",
            "ManagedBy": "inspector2.amazonaws.com",
            "EventBusName": "default"
        },
        {
            "Name": "NewRelic-AWS-Integration-Newre-DeleteStackEventRule-OvYKtRtpuFxA",
            "Arn": "arn:aws:events:us-west-2:363979333641:rule/NewRelic-AWS-Integration-Newre-DeleteStackEventRule-OvYKtRtpuFxA",
            "State": "ENABLED",
            "Description": "Delete stack event",
            "ScheduleExpression": "cron(44 19 * * ? *)",
            "EventBusName": "default"
        },
        {
            "Name": "NotificationReceiver-SqsCleanupFunction",
            "Arn": "arn:aws:events:us-west-2:363979333641:rule/NotificationReceiver-SqsCleanupFunction",
            "State": "ENABLED",
            "ScheduleExpression": "rate(1 hour)",
            "EventBusName": "default"
        },
        {
            "Name": "SSMExplorerManagedRule",
            "Arn": "arn:aws:events:us-west-2:363979333641:rule/SSMExplorerManagedRule",
            "EventPattern": "{\"source\":[\"aws.securityhub\"],\"detail-type\":[\"Security Hub Insight Results\",\"Security Hub Findings\",\"Security Hub Findings - Imported\",\"Security Hub Findings - Custom Action\"]}",
            "State": "ENABLED",
            "Description": "This rule is managed by SSM Explorer to provide comprehensive insights across AWS services",
            "ManagedBy": "ssm.amazonaws.com",
            "EventBusName": "default"
        },
        {
            "Name": "aws-controltower-ConfigComplianceChangeEventRule",
            "Arn": "arn:aws:events:us-west-2:363979333641:rule/aws-controltower-ConfigComplianceChangeEventRule",
            "EventPattern": "{\"detail-type\":[\"Config Rules Compliance Change\"],\"source\":[\"aws.config\"]}",
            "State": "ENABLED",
            "Description": "CloudWatch Event Rule to send notification on Config Rule compliance changes.",
            "EventBusName": "default"
        },
        {
            "Name": "ebs-volume-modify-notifications",
            "Arn": "arn:aws:events:us-west-2:363979333641:rule/ebs-volume-modify-notifications",
            "EventPattern": "{\"source\":[\"aws.ec2\"],\"detail-type\":[\"EBS Volume Notification\"],\"detail\":{\"event\":[\"modifyVolume\"]}}",
            "State": "ENABLED",
            "EventBusName": "default"
        },
        {
            "Name": "ecs-events-content-data-prod",
            "Arn": "arn:aws:events:us-west-2:363979333641:rule/ecs-events-content-data-prod",
            "EventPattern": "{\"detail\":{\"clusterArn\":[\"arn:aws:ecs:us-west-2:363979333641:cluster/content-data-prod\"]},\"detail-type\":[\"ECS Service Action\",\"ECS Deployment State Change\"],\"source\":[\"aws.ecs\"]}",
            "State": "ENABLED",
            "Description": "Grab the ECS Events https://docs.aws.amazon.com/AmazonECS/latest/developerguide/ecs_cwe_events.html#ecs_service_events",
            "EventBusName": "default"
        },
        {
            "Name": "ecs-managed-capacity-provider-rule",
            "Arn": "arn:aws:events:us-west-2:363979333641:rule/ecs-managed-capacity-provider-rule",
            "EventPattern": "{\"source\":[\"aws.ec2\",\"aws.autoscaling\"],\"detail-type\":[\"EC2 Spot Instance Interruption Warning\",\"EC2 Instance-terminate Lifecycle Action\",\"EC2 Instance Launch Successful\"],\"detail\":{\"LifecycleHookName\":[\"ecs-managed-draining-termination-hook\", {\"exists\": false}]}}",
            "State": "ENABLED",
            "Description": "An Amazon ECS managed rule that supports capacity provider",
            "ManagedBy": "ecs.amazonaws.com",
            "EventBusName": "default"
        },
        {
            "Name": "ip-availability-check",
            "Arn": "arn:aws:events:us-west-2:363979333641:rule/ip-availability-check",
            "State": "ENABLED",
            "Description": "Invoke the lambda every minute",
            "ScheduleExpression": "rate(1 minute)",
            "EventBusName": "default"
        },
        {
            "Name": "nielsen_report_schedule",
            "Arn": "arn:aws:events:us-west-2:363979333641:rule/nielsen_report_schedule",
            "State": "ENABLED",
            "Description": "Schedule for Nielsen Report",
            "ScheduleExpression": "cron(0 8 ? * MON *)",
            "EventBusName": "default"
        },
        {
            "Name": "rate-5-minutes",
            "Arn": "arn:aws:events:us-west-2:363979333641:rule/rate-5-minutes",
            "State": "ENABLED",
            "Description": "Event that triggers once a day",
            "ScheduleExpression": "rate(5 minutes)",
            "EventBusName": "default"
        }
    ]
}
