# Example tfvars. Copy to terraform.tfvars or secrets.auto.tfvars and edit.

project_id = "vz-inscape-portfolio-dev"
region     = "us-west1"

# One map entry creates one Cloud SQL instance and one PSC endpoint.
instances = {
	qa = {
		instance_name       = "auxdb-qa-dre-test"
		sub_service         = "auxdb-qa"
		environment         = "qa"
		tier                = "db-custom-2-7680"
		database_version    = "MYSQL_8_0"
		availability_type   = "ZONAL" # Use REGIONAL for HA.
		deletion_protection = true
	}
}

# -----------------------------------------------------------------------------
# Shared VPC networking — host project: vz-inscape-dev
# -----------------------------------------------------------------------------
consumer_vpc_self_link    = "projects/vz-inscape-dev/global/networks/vz-inscape-dev-vpc-01"
consumer_subnet_self_link = "projects/vz-inscape-dev/regions/us-west1/subnetworks/vz-inscape-dev-us-west1-psc-01"

# Only flip to true if no sql.goog. private DNS zone exists in the shared VPC.
create_psc_dns = false
