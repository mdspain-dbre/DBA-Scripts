# Example tfvars. Copy to terraform.tfvars or secrets.auto.tfvars and edit.
# DO NOT commit real passwords to source control.

project_id    = "inscape-dev"
region        = "us-west1"
zone          = "us-west1-a"
instance_name = "auxdb-qa"

# Sizing
tier              = "db-custom-2-7680"
availability_type = "ZONAL"
disk_size_gb      = 100

# Secrets — leave blank here and set in secrets.auto.tfvars instead.
# mysql_root_password = "CHANGE_ME"
